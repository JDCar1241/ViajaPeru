# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env a Git: contiene llaves secretas.

PORT=3000

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el Backend, nunca en el Frontend ni en Git
SUPABASE_SERVICE_ROLE_KEY=
# Clave anon (pública): se usa para iniciar sesión y registrar cuentas. Obligatoria.
SUPABASE_ANON_KEY=

# ---- Frontend ----
# Origen del Frontend para CORS (Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
# URL pública del Frontend para el enlace del correo de confirmación (si no, se usa CORS_ORIGIN)
FRONT_URL=

# ---- Culqi (pagos con tarjeta) ----
# Llave SECRETA (sk_test_... / sk_live_...). La pública va en el .env del Front.
CULQI_SECRET_KEY=

# ---- Factiliza (consulta de DNI, carné de extranjería y RUC) ----
FACTILIZA_TOKEN=

# ---- Resend (correos de cancelación) ----
RESEND_API_KEY=
# Remitente; debe ser de un dominio verificado en Resend
EMAIL_FROM=ViajaPerú <onboarding@resend.dev>

# ---- Datos de la empresa en el PDF del comprobante (opcionales) ----
EMPRESA_NOMBRE=ViajaPeru
EMPRESA_RUC=
EMPRESA_DIRECCION=
PDF_PIE=
