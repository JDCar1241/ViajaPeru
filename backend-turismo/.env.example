# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env a Git: contiene llaves secretas.

PORT=3000

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el Backend, nunca en el Frontend ni en Git
SUPABASE_SERVICE_ROLE_KEY=
# Clave anon (pública): se usa para iniciar sesión y registrar cuentas. Obligatoria.
SUPABASE_ANON_KEY=

# ---- Frontend ----
# Origen del Frontend para CORS (Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
# URL pública del Frontend para el enlace del correo de confirmación (si no, se usa CORS_ORIGIN)
FRONT_URL=

# ---- Culqi (pagos con tarjeta) ----
# Llave SECRETA (sk_test_... / sk_live_...). La pública va en el .env del Front.
CULQI_SECRET_KEY=

# ---- Factiliza (consulta de DNI, carné de extranjería y RUC) ----
FACTILIZA_TOKEN=

# ---- Correos (bienvenida y cancelación) ----
# Usa UNO de los dos proveedores. Si están ambos, se usa Brevo.
# Brevo (gratis, 300/día, llega a cualquier cliente): brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
# Resend: con el remitente de prueba solo llega al correo dueño de la cuenta de Resend
RESEND_API_KEY=
# Remitente. Con Brevo: un correo verificado en Brevo > Senders (puede ser tu Gmail)
EMAIL_FROM=ViajaPerú <tucorreo@gmail.com>

# ---- Datos del vendedor ----
# Se muestran en el pie de página, Contacto, Términos, Libro de Reclamaciones y en el PDF del comprobante.
# Culqi los exige para pasar a producción. Los que queden vacíos no se muestran (el RUC sale "en trámite").
EMPRESA_NOMBRE=ViajaPerú
# Razón social o, con RUC 10 (persona natural), tu nombre completo
EMPRESA_RAZON_SOCIAL=
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
# Correo público de atención: también recibe los avisos del Libro de Reclamaciones
EMPRESA_CORREO=
# Dirección del establecimiento donde se emite, solo si es distinta del domicilio fiscal
EMPRESA_ESTABLECIMIENTO=
EMPRESA_HORARIO=Lunes a sábado, 9:00 a 18:00
PDF_PIE=
# IGV del comprobante (consúltalo con tu contador). Tasa incluida en el precio y tipo de operación:
# gravado (18 %), exonerado, inafecto o exportacion (p. ej. paquetes vendidos a no domiciliados)
IGV_TASA=0.18
IGV_AFECTACION=gravado
